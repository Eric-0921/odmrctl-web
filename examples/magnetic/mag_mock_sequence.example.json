{
  "schema_version": "0.2.0",
  "kind": "mag_mock_sequence",
  "id": "mock_seq_001",
  "name": "Example Mock Magnetic Sequence",
  "description": "A deterministic mock sequence showing accepted and rejected ramps for test replay.",
  "axes": {
    "x": { "max_current_a": 2.0, "ramp_rate_a_per_s": 0.5 },
    "y": { "max_current_a": 2.0, "ramp_rate_a_per_s": 0.5 },
    "z": { "max_current_a": 2.0, "ramp_rate_a_per_s": 0.5 }
  },
  "initial_current_a": [0.0, 0.0, 0.0],
  "sequence": [
    {
      "seq_idx": 0,
      "target_b_t": [0.001, 0.0, 0.002],
      "ramp_rate_a_per_s": 0.3,
      "settle_ms": 200,
      "expected_result": "accepted"
    },
    {
      "seq_idx": 1,
      "target_b_t": [0.002, 0.002, 0.002],
      "ramp_rate_a_per_s": 0.3,
      "settle_ms": 200,
      "expected_result": "accepted"
    },
    {
      "seq_idx": 2,
      "target_b_t": [0.01, 0.0, 0.0],
      "ramp_rate_a_per_s": 0.3,
      "settle_ms": 200,
      "expected_result": "rejected",
      "expected_rejection_reason": "current_limit_exceeded"
    },
    {
      "seq_idx": 3,
      "target_b_t": [0.001, 0.0, 0.002],
      "ramp_rate_a_per_s": 2.0,
      "settle_ms": 200,
      "expected_result": "rejected",
      "expected_rejection_reason": "ramp_rate_exceeded"
    },
    {
      "seq_idx": 4,
      "target_b_t": [0.0, 0.0, 0.0],
      "ramp_rate_a_per_s": 0.3,
      "settle_ms": 50,
      "expected_result": "rejected",
      "expected_rejection_reason": "settle_time_too_short"
    }
  ],
  "safety_policy_id": "mag_safety_lab_default",
  "coil_matrix_id": "coil_matrix_lab_default"
}
