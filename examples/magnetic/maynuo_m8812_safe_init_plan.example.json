{
  "schema_version": "0.2.0",
  "kind": "maynuo_command_plan",
  "id": "maynuo_safe_init_plan",
  "name": "Maynuo M8812 Safe Initialization Plan",
  "description": "Dry-run command plan for safe initialization of a single Maynuo M8812 axis. No hardware I/O is performed. This plan is generated by odmr-mag and validated by the safety engine before any future executor dispatch.",
  "axis_id": "mag_x",
  "profile_id": "maynuo_m8812_lab_xyz",
  "executable": false,
  "executable_reason": "Mag-M0.5 mock-only: requires Mag-M2B backend bring-up for real execution",
  "expected_duration_ms": 500,
  "commands": [
    {
      "seq": 1,
      "command_type": "identify",
      "scpi": "*IDN?",
      "expected_response_shape": "MAYNUO,M8812,<SN>,V2.7",
      "event_name": "mag_idn_queried",
      "blocking": true,
      "timeout_ms": 300
    },
    {
      "seq": 2,
      "command_type": "set_remote",
      "scpi": "SYST:REM",
      "expected_response_shape": "ACK",
      "event_name": "mag_remote_mode_set",
      "blocking": false,
      "delay_ms": 50
    },
    {
      "seq": 3,
      "command_type": "set_voltage",
      "scpi": "VOLT 75",
      "expected_response_shape": "ACK",
      "event_name": "mag_voltage_set",
      "blocking": false,
      "delay_ms": 50,
      "params": { "voltage_v": 75 }
    },
    {
      "seq": 4,
      "command_type": "set_current",
      "scpi": "CURR 0.00000",
      "expected_response_shape": "ACK",
      "event_name": "mag_current_zeroed",
      "blocking": false,
      "delay_ms": 50,
      "params": { "current_a": 0.0, "current_ma": 0.0 }
    },
    {
      "seq": 5,
      "command_type": "set_output",
      "scpi": "OUTP 0",
      "expected_response_shape": "ACK",
      "event_name": "mag_output_disabled",
      "blocking": false,
      "delay_ms": 50,
      "params": { "output": false }
    },
    {
      "seq": 6,
      "command_type": "query_current",
      "scpi": "MEAS:CURR?",
      "expected_response_shape": "0.00000",
      "event_name": "mag_current_queried",
      "blocking": true,
      "timeout_ms": 300,
      "expected_value_ma": 0.0
    },
    {
      "seq": 7,
      "command_type": "set_output",
      "scpi": "OUTP 0",
      "expected_response_shape": "ACK",
      "event_name": "mag_output_confirmed_off",
      "blocking": false,
      "delay_ms": 50,
      "params": { "output": false }
    },
    {
      "seq": 8,
      "command_type": "set_local",
      "scpi": "SYST:LOC",
      "expected_response_shape": "ACK",
      "event_name": "mag_local_mode_set",
      "blocking": false,
      "delay_ms": 50
    }
  ],
  "safety_check": {
    "max_current_a": 0.0,
    "max_current_ma": 0.0,
    "voltage_v": 75,
    "output_enabled": false,
    "decision": "allow",
    "findings": []
  },
  "artifact_outputs": [
    "magnetic_events.jsonl",
    "magnetic_state_timeline.jsonl"
  ]
}
