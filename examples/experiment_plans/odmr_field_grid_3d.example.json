{
  "schema_version": "0.1.0",
  "kind": "experiment_plan",
  "id": "odmr_field_grid_3d_demo",
  "name": "ODMR 3D magnetic volume grid demo",
  "source": "examples/experiment_plans/odmr_field_grid_3d.example.json",
  "station_ref": "odmr_station.full.example",
  "field_space": {
    "mode": "grouped_grid_scan",
    "unit": "nT",
    "groups": [
      {
        "group_id": "bx_by_bz_volume",
        "label_cn": "Bx-By-Bz 三维体网格",
        "scan_kind": "volume_3d",
        "axes": ["x", "y", "z"],
        "axis_ranges_nt": {
          "x": { "start": 0, "stop": 20, "step": 10 },
          "y": { "start": 0, "stop": 20, "step": 10 },
          "z": { "start": 0, "stop": 20, "step": 10 }
        },
        "fixed_axes_nt": {},
        "order": 0,
        "enabled": true
      }
    ]
  },
  "spectrum_template": {
    "rf_sweep": {
      "start_hz": 2800000000,
      "stop_hz": 2900000000,
      "step_hz": 1000000,
      "dwell_ms": 300,
      "power_dbm": -30,
      "spacing": "LINear",
      "shape": "SAWtooth",
      "sweep_output_start_v": 0,
      "sweep_output_stop_v": 3
    },
    "laser": {
      "mode": "fixed_power",
      "power_mw": 0,
      "enabled": false,
      "settle_ms": 100
    },
    "oe1022d_acquisition": {
      "mode": "follow_rf_sweep",
      "pre_start_ms": 100,
      "post_stop_ms": 100,
      "channels": {
        "ch_a": {
          "time_constant_s": 0.3,
          "filter_slope_db_oct": 12,
          "dynamic_reserve": "NORMAL",
          "sensitivity": "100 mV/nA"
        },
        "ch_b": {
          "time_constant_s": 0.3,
          "filter_slope_db_oct": 12,
          "dynamic_reserve": "NORMAL",
          "sensitivity": "100 mV/nA"
        }
      }
    }
  },
  "runtime_requirements": {
    "require_preflight": true,
    "require_zero_lock": true
  }
}
