    {"step": 5, "command": "FM:MODE HDEV", "comment_cn": "高偏差模式"},
    {"step": 6, "command": "FM:DEV 3.5E6", "comment_cn": "FM 偏差 3.5 MHz"},
    {"step": 7, "command": "LFO:FREQ 500", "comment_cn": "LF 频率 500 Hz(影响 FM 调制信号)"},
    {"step": 8, "command": "LFO:SHAP SQU", "comment_cn": "LF 波形 = Square"},
    {"step": 9, "command": "OUTP ON", "comment_cn": "RF 实际输出"},
    {"step": 10, "command": "MOD:STAT ON", "comment_cn": "MOD ON,确保 FM 状态被激活"}
